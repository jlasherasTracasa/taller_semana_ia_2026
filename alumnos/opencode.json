{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/GLM-5.3-Flash",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM del taller",
      "options": {
        "baseURL": "{env:LITELLM_API_BASE}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "GLM-5.3-Flash": {
          "name": "GLM-5.3-Flash",
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "kill *": "deny",
      "pkill *": "deny",
      "killall *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push *": "ask",
      "crontab *": "ask",
      "systemctl *": "ask"
    }
  }
}