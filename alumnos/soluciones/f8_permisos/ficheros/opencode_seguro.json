{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "read": "allow",
    "webfetch": "ask",
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "python3 *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git *": "allow",
      "rm -*": "deny",
      "sudo *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "chmod -R *": "deny",
      "cat ~/.ssh/*": "deny",
      "curl *": "deny",
      "git push *": "ask",
      "git reset --hard *": "ask",
      "crontab *": "ask",
      "* | sh": "deny"
    }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://litellm.ejemplo.local/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      }
    }
  }
}
