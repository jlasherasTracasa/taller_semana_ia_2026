# .env — privado: NUNCA lo subas a git ni lo compartas. Copia este archivo a .env y rellénalo.
# ¿Usas el modelo GRATUITO de opencode? Entonces no necesitas este fichero.

# Clave de OpenRouter (la que os dan en clase): el kit usará GLM-5.3-Flash
OPENROUTER_API_KEY=

# (Opcional) otro modelo, con el formato proveedor/modelo. Ejemplo: opencode/nemotron-3-ultra-free
TALLER_MODELO=

# (Solo el docente) LiteLLM propio
LITELLM_API_BASE=
LITELLM_API_KEY=
