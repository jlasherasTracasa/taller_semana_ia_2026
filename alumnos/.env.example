# .env — privado: NUNCA lo subas a git ni lo compartas. Copia este archivo a .env y rellénalo.
# ¿Usas el modelo GRATUITO de opencode? Entonces no necesitas este fichero.

# Clave de OpenRouter (la que os dan en clase): el kit usará GLM-5.3-Flash
OPENROUTER_API_KEY=

# Sin OpenRouter, para F.0 y F.1 (programas en Python): una clave GRATUITA y personal, sin tarjeta.
# Recomendada: Groq (console.groq.com/keys → Create API Key). Paso a paso con capturas en la wiki: Modelos
GROQ_API_KEY=
# Alternativa: Google AI Studio (aistudio.google.com/apikey → Create API key)
GEMINI_API_KEY=
# (Opcional) otro modelo SOLO para F.0 y F.1, con el formato de litellm. Ejemplo: groq/qwen/qwen3.8-27b
TALLER_MODELO_PY=

# (Opcional) otro modelo, con el formato proveedor/modelo. Ejemplo: opencode/glm-5.3-flash-free
TALLER_MODELO=

# (Solo el docente) LiteLLM propio
LITELLM_API_BASE=
LITELLM_API_KEY=
